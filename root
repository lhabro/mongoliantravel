<!DOCTYPE html>
<html lang="mn">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Mongolian Travel – Нийтлэл бичих</title>
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet">
<style>
  * { margin: 0; padding: 0; box-sizing: border-box; }
  body { font-family: 'DM Sans', sans-serif; background: #F7F3EC; color: #1A1208; min-height: 100vh; }
  
  header { background: #1A1208; padding: 1rem 2rem; display: flex; align-items: center; justify-content: space-between; }
  header h1 { color: #D4B483; font-size: 1.1rem; font-weight: 500; }
  
  .container { max-width: 800px; margin: 2rem auto; padding: 0 1.5rem; }
  
  .token-section { background: white; border-radius: 12px; padding: 1.5rem; margin-bottom: 1.5rem; border: 1px solid #e8e0d4; }
  .token-section h2 { font-size: 1rem; font-weight: 500; margin-bottom: 0.5rem; }
  .token-section p { font-size: 0.85rem; color: #7A6A55; margin-bottom: 1rem; }
  .token-status { display: flex; align-items: center; gap: 8px; font-size: 0.85rem; }
  .dot { width: 8px; height: 8px; border-radius: 50%; background: #ccc; }
  .dot.active { background: #1D9E75; }

  .form-section { background: white; border-radius: 12px; padding: 1.5rem; border: 1px solid #e8e0d4; }
  
  .field { margin-bottom: 1.2rem; }
  label { display: block; font-size: 0.8rem; font-weight: 500; color: #7A6A55; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 6px; }
  input, select, textarea { width: 100%; padding: 10px 14px; border: 1px solid #d9d2c5; border-radius: 8px; font-size: 0.9rem; font-family: 'DM Sans', sans-serif; color: #1A1208; background: #FFFDF9; outline: none; transition: border 0.2s; }
  input:focus, select:focus, textarea:focus { border-color: #C1440E; }
  textarea { resize: vertical; line-height: 1.6; }

  .grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
  @media (max-width: 600px) { .grid-2 { grid-template-columns: 1fr; } }

  .image-upload { border: 2px dashed #d9d2c5; border-radius: 8px; padding: 1.5rem; text-align: center; cursor: pointer; transition: border 0.2s; }
  .image-upload:hover { border-color: #C1440E; }
  .image-upload input { display: none; }
  .image-upload p { font-size: 0.85rem; color: #7A6A55; margin-top: 8px; }
  .image-preview { max-width: 100%; border-radius: 8px; margin-top: 1rem; display: none; }

  .btn { display: inline-block; padding: 12px 28px; border-radius: 30px; font-size: 0.9rem; font-weight: 500; cursor: pointer; border: none; transition: all 0.2s; }
  .btn-primary { background: #C1440E; color: white; width: 100%; }
  .btn-primary:hover { background: #a33a0c; }
  .btn-primary:disabled { background: #ccc; cursor: not-allowed; }
  .btn-secondary { background: none; border: 1px solid #d9d2c5; color: #7A6A55; margin-right: 8px; }

  .status { padding: 12px 16px; border-radius: 8px; font-size: 0.85rem; margin-top: 1rem; display: none; }
  .status.success { background: #E1F5EE; color: #0F6E56; display: block; }
  .status.error { background: #FCEBEB; color: #A32D2D; display: block; }
  .status.loading { background: #E6F1FB; color: #185FA5; display: block; }

  .modal { position: fixed; inset: 0; background: rgba(0,0,0,0.5); display: flex; align-items: center; justify-content: center; padding: 1rem; z-index: 100; }
  .modal-box { background: white; border-radius: 16px; padding: 2rem; max-width: 440px; width: 100%; }
  .modal-box h2 { font-size: 1.1rem; margin-bottom: 0.5rem; }
  .modal-box p { font-size: 0.85rem; color: #7A6A55; margin-bottom: 1rem; line-height: 1.6; }
  .modal-box input { width: 100%; padding: 10px 14px; border: 1px solid #d9d2c5; border-radius: 8px; font-size: 0.9rem; margin-bottom: 1rem; }
  .modal-actions { display: flex; justify-content: flex-end; gap: 8px; }
</style>
</head>
<body>

<header>
  <h1>Mongolian Travel – Нийтлэл бичих</h1>
  <button class="btn btn-secondary" onclick="showTokenModal()" style="font-size:0.8rem;padding:6px 14px">⚙ Token</button>
</header>

<div class="container">
  <div class="token-section">
    <h2>GitHub холболт</h2>
    <p>Нийтлэл GitHub-д хадгалагдана. Эхлээд GitHub token-оо оруулна уу.</p>
    <div class="token-status">
      <div class="dot" id="token-dot"></div>
      <span id="token-text">Token оруулаагүй байна</span>
    </div>
  </div>

  <div class="form-section">
    <div class="field">
      <label>Гарчиг (Монгол)</label>
      <input type="text" id="title_mn" placeholder="Нийтлэлийн гарчиг монголоор">
    </div>
    <div class="field">
      <label>Гарчиг (Англи)</label>
      <input type="text" id="title_en" placeholder="Article title in English">
    </div>
    <div class="grid-2">
      <div class="field">
        <label>Ангилал</label>
        <select id="category">
          <option value="Аялал">🏕 Аялал</option>
          <option value="Хоол">🍖 Хоол</option>
          <option value="Амьдрал">🌿 Амьдрал</option>
        </select>
      </div>
      <div class="field">
        <label>Огноо</label>
        <input type="date" id="date">
      </div>
    </div>

    <div class="field">
      <label>Зураг оруулах</label>
      <div class="image-upload" onclick="document.getElementById('image-input').click()">
        <input type="file" id="image-input" accept="image/*" onchange="handleImage(this)">
        <div style="font-size:2rem">📷</div>
        <p>Зураг сонгохын тулд дарна уу</p>
      </div>
      <img id="image-preview" class="image-preview">
    </div>

    <div class="field">
      <label>Агуулга (Монгол)</label>
      <textarea id="body_mn" rows="8" placeholder="Нийтлэлийн агуулгаа монголоор бичнэ үү..."></textarea>
    </div>
    <div class="field">
      <label>Агуулга (Англи)</label>
      <textarea id="body_en" rows="8" placeholder="Write your article content in English..."></textarea>
    </div>

    <button class="btn btn-primary" onclick="publish()" id="publish-btn">Нийтлэх</button>
    <div class="status" id="status"></div>
  </div>
</div>

<!-- Token Modal -->
<div class="modal" id="token-modal">
  <div class="modal-box">
    <h2>GitHub Token оруулах</h2>
    <p>GitHub → Settings → Developer settings → Personal access tokens → Generate new token (classic) → repo чагтлаад үүсгэнэ үү.</p>
    <input type="password" id="token-input" placeholder="ghp_xxxxxxxxxxxxx">
    <div class="modal-actions">
      <button class="btn btn-secondary" onclick="closeModal()">Болих</button>
      <button class="btn btn-primary" style="width:auto" onclick="saveToken()">Хадгалах</button>
    </div>
  </div>
</div>

<script>
  let githubToken = localStorage.getItem('gh_token') || '';
  let imageData = null;
  let imageName = null;

  document.getElementById('date').value = new Date().toISOString().split('T')[0];

  function updateTokenStatus() {
    const dot = document.getElementById('token-dot');
    const text = document.getElementById('token-text');
    if (githubToken) {
      dot.className = 'dot active';
      text.textContent = 'Token хадгалагдсан ✓';
      document.getElementById('token-modal').style.display = 'none';
    } else {
      dot.className = 'dot';
      text.textContent = 'Token оруулаагүй байна';
    }
  }

  function showTokenModal() {
    document.getElementById('token-modal').style.display = 'flex';
  }

  function closeModal() {
    document.getElementById('token-modal').style.display = 'none';
  }

  function saveToken() {
    const token = document.getElementById('token-input').value.trim();
    if (token) {
      githubToken = token;
      localStorage.setItem('gh_token', token);
      document.getElementById('token-input').value = '';
      updateTokenStatus();
    }
  }

  function handleImage(input) {
    const file = input.files[0];
    if (!file) return;
    imageName = file.name.replace(/[^a-zA-Z0-9.-]/g, '_');
    const reader = new FileReader();
    reader.onload = function(e) {
      imageData = e.target.result.split(',')[1];
      const preview = document.getElementById('image-preview');
      preview.src = e.target.result;
      preview.style.display = 'block';
    };
    reader.readAsDataURL(file);
  }

  function showStatus(msg, type) {
    const el = document.getElementById('status');
    el.textContent = msg;
    el.className = 'status ' + type;
  }

  async function uploadImage() {
    if (!imageData || !imageName) return null;
    const path = `images/${Date.now()}_${imageName}`;
    const response = await fetch(`https://api.github.com/repos/lhabro/mongoliantravel/contents/${path}`, {
      method: 'PUT',
      headers: {
        'Authorization': `token ${githubToken}`,
        'Content-Type': 'application/json',
      },
      body: JSON.stringify({
        message: `Add image ${imageName}`,
        content: imageData,
      }),
    });
    if (!response.ok) throw new Error('Зураг upload хийхэд алдаа гарлаа');
    return `/${path}`;
  }

  async function publish() {
    if (!githubToken) { showTokenModal(); return; }

    const title_mn = document.getElementById('title_mn').value.trim();
    const title_en = document.getElementById('title_en').value.trim();
    const category = document.getElementById('category').value;
    const date = document.getElementById('date').value;
    const body_mn = document.getElementById('body_mn').value.trim();
    const body_en = document.getElementById('body_en').value.trim();

    if (!title_mn) { showStatus('Монгол гарчиг оруулна уу!', 'error'); return; }
    if (!body_mn) { showStatus('Монгол агуулга оруулна уу!', 'error'); return; }

    const btn = document.getElementById('publish-btn');
    btn.disabled = true;
    showStatus('Нийтлэж байна...', 'loading');

    try {
      let imageMarkdown = '';
      if (imageData) {
        showStatus('Зураг upload хийж байна...', 'loading');
        const imagePath = await uploadImage();
        imageMarkdown = `\n\n![${title_mn}](${imagePath})`;
      }

      const slug = title_mn.toLowerCase()
        .replace(/[^a-zA-Z0-9\u0400-\u04FF\s]/g, '')
        .replace(/\s+/g, '-')
        .slice(0, 50) + '-' + Date.now();

      const content = `---
title_mn: ${title_mn}
title_en: ${title_en || title_mn}
category: ${category}
date: ${date}T00:00:00.000Z
body_mn: |-
  ${body_mn.replace(/\n/g, '\n  ')}${imageMarkdown}
body_en: |-
  ${(body_en || body_mn).replace(/\n/g, '\n  ')}
---`;

      const encoded = btoa(unescape(encodeURIComponent(content)));

      const response = await fetch(`https://api.github.com/repos/lhabro/mongoliantravel/contents/posts/${slug}.md`, {
        method: 'PUT',
        headers: {
          'Authorization': `token ${githubToken}`,
          'Content-Type': 'application/json',
        },
        body: JSON.stringify({
          message: `Нийтлэл нэмэх: ${title_mn}`,
          content: encoded,
        }),
      });

      if (!response.ok) {
        const err = await response.json();
        throw new Error(err.message || 'Алдаа гарлаа');
      }

      showStatus('✓ Нийтлэл амжилттай нийтлэгдлээ! 2-3 минутад сайт дээр харагдана.', 'success');
      document.getElementById('title_mn').value = '';
      document.getElementById('title_en').value = '';
      document.getElementById('body_mn').value = '';
      document.getElementById('body_en').value = '';
      document.getElementById('image-preview').style.display = 'none';
      imageData = null;
      imageName = null;

    } catch (err) {
      showStatus('Алдаа: ' + err.message, 'error');
    } finally {
      btn.disabled = false;
    }
  }

  updateTokenStatus();
  if (!githubToken) showTokenModal();
</script>
</body>
</html>
